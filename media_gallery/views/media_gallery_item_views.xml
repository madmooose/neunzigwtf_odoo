<odoo>
    <record id="view_media_gallery_item_tree" model="ir.ui.view">
        <field name="name">media.gallery.item.tree</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button
                        name="%(action_media_gallery_batch_upload_wizard)d"
                        type="action"
                        string="Batch Upload"
                        class="btn-primary"
                    />
                </header>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="file_type" />
                <field name="gallery_id" />
                <field name="state" />
                <field name="visibility" />
            </tree>
        </field>
    </record>
    <record id="view_media_gallery_item_form" model="ir.ui.view">
        <field name="name">media.gallery.item.form</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        data-hotkey="a"
                        attrs="{'invisible': [('state', '=', 'approved')]}"
                    />
                    <button
                        name="action_deny"
                        type="object"
                        string="Deny"
                        class="btn-primary"
                        data-hotkey="d"
                        attrs="{'invisible': [('state', '!=', 'approved')]}"
                    />
                    <button
                        name="action_deny"
                        type="object"
                        string="Deny"
                        class="btn-secondary"
                        data-hotkey="d"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                </header>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="description" />
                            <field name="visibility" />
                        </group>
                        <group>
                            <field name="gallery_id" />
                            <field name="subject_ids">
                                <tree editable="bottom">
                                    <field name="user_id" />
                                    <field name="visibility" />
                                </tree>
                                <form string="Add Subject">
                                    <group>
                                        <field name="user_id" />
                                        <field name="visibility" />
                                    </group>
                                </form>
                            </field>
                        </group>
                        <group>

                        </group>
                    </group>
                            <field name="image_1920" widget="image" />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>
    <record id="view_media_gallery_item_kanban" model="ir.ui.view">
        <field name="name">media.gallery.item.kanban</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" invisible="1" />
                <field name="sequence" widget="handle" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" type="form">
                            <div class="o_kanban_image_full me-1">
                                <img
                                    t-att-src="kanban_image('media.gallery.item', 'image_256', record.id.raw_value)"
                                    alt="Photo"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="kanban-header">
                        <div class="o_kanban_buttons">
                            <button
                                type="action"
                                name="%(action_media_gallery_batch_upload_wizard)d"
                                class="btn btn-primary"
                            >Batch Upload</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_media_gallery_item" model="ir.actions.act_window">
        <field name="name">Media Gallery Items</field>
        <field name="res_model">media.gallery.item</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <record id="action_media_gallery_item_no_gallery" model="ir.actions.act_window">
        <field name="name">Media Gallery Items</field>
        <field name="res_model">media.gallery.item</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('gallery_id','=',False)]</field>
    </record>
</odoo>
