<odoo>
    <record id="view_media_gallery_item_tree" model="ir.ui.view">
        <field name="name">media.gallery.item.tree</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="file_type" />
                <field name="gallery_id" />
            </tree>
        </field>
    </record>
    <record id="view_media_gallery_item_form" model="ir.ui.view">
        <field name="name">media.gallery.item.form</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_256" widget="image" class="oe_avatar" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="description" />
                        </group>
                        <group>
                            <field name="file_type" />
                            <field name="gallery_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_media_gallery_item_kanban" model="ir.ui.view">
        <field name="name">media.gallery.item.kanban</field>
        <field name="model">media.gallery.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <field name="name" />
                <field name="image_256" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image_full me-1">
                                <img
                                    t-att-src="kanban_image('media.gallery.item', 'image_256', record.id.raw_value)"
                                    alt="Photo"
                                />
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_media_gallery_item" model="ir.actions.act_window">
        <field name="name">Media Gallery Items</field>
        <field name="res_model">media.gallery.item</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <record id="action_media_gallery_item_no_gallery" model="ir.actions.act_window">
        <field name="name">Media Gallery Items</field>
        <field name="res_model">media.gallery.item</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('gallery_id','=',False)]</field>
    </record>
</odoo>
