<odoo>
    <template
        id="portal_my_home_media_galleries"
        name="Show Media Galleries in My Account"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="50"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Own Media items</t>
                <t t-set="url" t-value="'/my/own_media_items'" />
                <t t-set="placeholder_count" t-value="'own_media_item_count'" />
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Approve Media Items</t>
                <t t-set="url" t-value="'/my/approve_media_items'" />
                <t t-set="placeholder_count" t-value="'media_item_approval_count'" />
            </t>
        </xpath>
    </template>

    <template
        id="portal_my_home_menu_media_item"
        name="Portal layout: media item menu entries"
        inherit_id="portal.portal_breadcrumbs"
        priority="35"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'own_media_items'"
                t-attf-class="breadcrumb-item #{'' if item else 'active'}"
            >
                <a
                    t-if="item"
                    t-attf-href="/my/own_media_items?{{ keep_query() }}"
                >Own Media Items</a>
                <t t-else="">Own Media Items</t>
            </li>
            <li
                t-if="page_name == 'approve_media_items'"
                t-attf-class="breadcrumb-item #{'' if item else 'active'}"
            >
                <a
                    t-if="item"
                    t-attf-href="/my/approve_media_items?{{ keep_query() }}"
                >Approve Media Items</a>
                <t t-else="">Approve Media Items</t>
            </li>
            <li t-if="item" class="breadcrumb-item">
                <t t-esc="item.name" />
            </li>
        </xpath>
    </template>

    <template id="portal_media_item_list_template" name="Own Media Items">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Media Items</t>
            </t>
            <t t-if="not items">
                <p>Currently you don't have any media items.</p>
            </t>
            <div class="o_portal_media_item">
                <div class="items">
                    <div class="item-list row m-0">
                        <t t-foreach="items" t-as="item">
                            <a
                                t-attf-href="/my/{{ 'own_media_items' if page_name == 'own_media_items' else 'approve_media_items' }}/{{ str(item.id) }}"
                                class="col-6 col-sm-6 col-md-4 col-lg-3 p-0"
                                t-if="item.file_type == 'image'"
                            >
                                <div class="media-item">
                                    <div>
                                        <strong t-esc="item.name" />
                                    </div>
                                    <div>
                                        <img
                                            t-att-src="'/web/image/media.gallery.item/' + str(item.id) + '/image_256'"
                                            alt="Media"
                                            style="min-width:170px; max-width: 100%; border-radius:6px;"
                                        />
                                    </div>
                                    <div>
                                        <t t-esc="item.description" />
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_media_gallery_item_template" name="Gallery Item">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Galleries</t>
            </t>
            <div class="o_portal_media_gallery_item" style="text-align:center;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <t t-if="prev_id">
                            <a
                                id="prev-btn"
                                t-attf-href="/my/{{ 'own_media_items' if page_name == 'own_media_items' else 'approve_media_items' }}/{{ str(prev_id) }}"
                                class="btn btn-primary"
                            >
                                <i class="fa fa-arrow-left" aria-hidden="true" />
                                <span class="d-none d-sm-inline">Previous</span>
                            </a>
                        </t>
                    </div>
                    <div class="text-center flex-grow-1">
                        <div class="mb-2">
                            <form method="post" t-if="subject">
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />
                                <button
                                    type="submit"
                                    name="visibility"
                                    value="own"
                                    t-attf-class="btn btn{{'-outline' if subject.visibility != 'own' else ''}}-primary mx-1"
                                    t-att-disabled="subject.visibility == 'own'"
                                >
                                    <i class="fa fa-eye-slash" aria-hidden="true" />
                                    <span class="d-none d-sm-inline"> Own</span>
                                </button>
                                <button
                                    type="submit"
                                    name="visibility"
                                    value="users"
                                    t-attf-class="btn btn{{'-outline' if subject.visibility != 'users' else ''}}-primary mx-1"
                                    t-att-disabled="subject.visibility == 'users'"
                                >
                                    <i class="fa fa-users" aria-hidden="true" />
                                    <span class="d-none d-sm-inline"> Users</span>
                                </button>
                                <button
                                    type="submit"
                                    name="visibility"
                                    value="public"
                                    t-attf-class="btn btn{{'-outline' if subject.visibility != 'public' else ''}}-primary mx-1"
                                    t-att-disabled="subject.visibility == 'public'"
                                >
                                    <i class="fa fa-globe" aria-hidden="true" />
                                    <span class="d-none d-sm-inline"> Public</span>
                                </button>
                            </form>
                        </div>
                        <div class="text-muted mb-2"><t
                                t-esc="item.description"
                            /></div>
                    </div>
                    <div>
                        <t t-if="next_id">
                            <a
                                id="next-btn"
                                t-attf-href="/my/{{ 'own_media_items' if page_name == 'own_media_items' else 'approve_media_items' }}/{{ str(next_id) }}"
                                class="btn btn-primary"
                            >
                                <span class="d-none d-sm-inline"> Next</span>
                                <i class="fa fa-arrow-right" aria-hidden="true" />
                            </a>
                        </t>
                    </div>
                </div>
                <div class="text-center">
                    <img
                        t-att-src="'/web/image/media.gallery.item/' + str(item.id) + '/image_1920'"
                        alt="Media"
                        class="img-fluid rounded shadow"
                        style="max-width:100%;"
                    />
                </div>
                <t t-if="prev_id">
                    <link
                        rel="preload"
                        as="image"
                        t-att-href="'/web/image/media.gallery.item/' + str(prev_id) + '/image_1920'"
                    />
                </t>
                <t t-if="next_id">
                    <link
                        rel="preload"
                        as="image"
                        t-att-href="'/web/image/media.gallery.item/' + str(next_id) + '/image_1920'"
                    />
                </t>
            </div>
        </t>
    </template>
</odoo>
