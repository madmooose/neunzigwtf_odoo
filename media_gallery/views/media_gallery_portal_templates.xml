<odoo>
    <template
        id="portal_my_home_media_galleries"
        name="Show Media Galleries in My Account"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="50"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Own Media items</t>
                <t t-set="url" t-value="'/my/own_media_item'" />
                <t t-set="placeholder_count" t-value="'own_media_item_count'" />
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Approve Media Items</t>
                <t t-set="url" t-value="'/my/approve_media_item'" />
                <t t-set="placeholder_count" t-value="'media_item_approval_count'" />
            </t>
        </xpath>
    </template>

    <template
        id="portal_my_home_menu_media_item"
        name="Portal layout: media item menu entries"
        inherit_id="portal.portal_breadcrumbs"
        priority="35"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'own_media_items'"
                t-attf-class="breadcrumb-item #{'' if item else 'active'}"
            >
                <a
                    t-if="item"
                    t-attf-href="/my/own_media_items?{{ keep_query() }}"
                >Own Media Items</a>
                <t t-else="">Own Media Items</t>
            </li>
            <li
                t-if="page_name == 'approve_media_items'"
                t-attf-class="breadcrumb-item #{'' if item else 'active'}"
            >
                <a
                    t-if="item"
                    t-attf-href="/my/approve_media_items?{{ keep_query() }}"
                >Approve Media Items</a>
                <t t-else="">Approve Media Items</t>
            </li>
            <li
                t-if="item"
                t-attf-class="breadcrumb-item"
            >
                <t t-esc="item.name" />
            </li>
        </xpath>
    </template>

    <template id="portal_own_media_item_list_template" name="Own Media Items">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Own Media Items</t>
            </t>
            <t t-if="not items">
                <p>Currently you don't have any own media items.</p>
            </t>
            <div class="o_portal_media_item">
                <div class="items">
                    <div
                        class="item-list"
                        style="display: flex; flex-wrap: wrap; gap: 24px;"
                    >
                        <t t-foreach="items" t-as="item">
                            <a
                                t-att-href="'/my/own_media_items/' + str(item.id)"
                                style="text-decoration:none; color:inherit;"
                            >
                                <div
                                    class="item-card bg-white"
                                    style="border: 1px solid #ddd; border-radius: 8px; padding: 12px; width: 220px; background: #fafafa; cursor:pointer;"
                                >
                                    <div style="text-align:center;">
                                        <img
                                            t-att-src="'/web/image/media.gallery.item/' + str(item.id) + '/image_256'"
                                            alt="Image"
                                            style="max-width:180px; max-height:120px; border-radius:6px; margin-bottom:8px;"
                                        />
                                    </div>
                                    <div><strong><t
                                                t-esc="item.name"
                                            /></strong></div>
                                    <div><t t-esc="item.description" /></div>
                                </div>
                            </a>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_media_gallery_detail_template" name="Gallery">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Galleries</t>
            </t>
            <t t-if="not media_items">
                <p>There are currently no media items in this gallery.</p>
            </t>
            <div class="o_portal_media_gallery_detail">
                <div class="gallery-description"><t t-esc="gallery.description" /></div>
                <div
                    class="media-items"
                    style="display: flex; flex-wrap: wrap; gap: 24px; margin-top: 24px;"
                >
                    <t t-foreach="media_items" t-as="item">
                            <a
                            t-att-href="'/my/gallery/item/' + str(item.id)"
                            style="text-decoration:none; color:inherit;"
                            t-if="item.file_type == 'image'"
                        >
                                <div
                                class="media-item  bg-white"
                                style="border: 1px solid #eee; border-radius: 8px; padding: 12px; width: 220px; background: #fff;"
                            >
                                    <img
                                    t-att-src="'/web/image/media.gallery.item/' + str(item.id) + '/image_256'"
                                    alt="Media"
                                    style="max-width:200px; border-radius:6px; margin-bottom:8px;"
                                />
                                    <div><strong><t t-esc="item.name" /></strong></div>
                                    <div><t t-esc="item.description" /></div>
                                </div>
                            </a>
                    </t>
                </div>
            </div>
        </t>
    </template>
    <template id="portal_media_gallery_item_template" name="Gallery Item">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Galleries</t>
            </t>
            <div class="o_portal_media_gallery_item" style="text-align:center;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <t t-if="prev_id">
                            <a
                                id="prev-btn"
                                t-att-href="'/my/gallery/item/' + str(prev_id)"
                                class="btn btn-secondary"
                            >
                                <i
                                    class="fa fa-arrow-left"
                                    aria-hidden="true"
                                /> Previous
                            </a>
                        </t>
                    </div>
                    <div class="text-center flex-grow-1">
                        <div class="text-muted mb-2"><t
                                t-esc="item.description"
                            /></div>
                    </div>
                    <div>
                        <t t-if="next_id">
                            <a
                                id="next-btn"
                                t-att-href="'/my/gallery/item/' + str(next_id)"
                                class="btn btn-secondary"
                            >
                                Next <i class="fa fa-arrow-right" aria-hidden="true" />
                            </a>
                        </t>
                    </div>
                </div>
                <div class="text-center">
                    <img
                        t-att-src="'/web/image/media.gallery.item/' + str(item.id) + '/image_1920'"
                        alt="Media"
                        class="img-fluid rounded shadow"
                        style="max-width:100%;"
                    />
                </div>
                <t t-if="prev_id">
                    <link
                        rel="preload"
                        as="image"
                        t-att-href="'/web/image/media.gallery.item/' + str(prev_id) + '/image_1920'"
                    />
                </t>
                <t t-if="next_id">
                    <link
                        rel="preload"
                        as="image"
                        t-att-href="'/web/image/media.gallery.item/' + str(next_id) + '/image_1920'"
                    />
                </t>
            </div>
        </t>
    </template>
</odoo>
