<odoo>
    <!-- MediaGalleryItem views moved to media_gallery_item_views.xml -->
    <record id="view_media_gallery_tree" model="ir.ui.view">
        <field name="name">media.gallery.tree</field>
        <field name="model">media.gallery</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>
    <record id="view_media_gallery_form" model="ir.ui.view">
        <field name="name">media.gallery.form</field>
        <field name="model">media.gallery</field>
        <field name="arch" type="xml">
            <form>
                <header>
                        <button
                        name="action_open_add_file_wizard"
                        type="object"
                        string="Add Image"
                        class="oe_stat_button btn-primary"
                    />
                </header>
                <sheet>
                    <field name="cover_image" widget="image" class="oe_avatar" />
                    <h1><field name="name" /></h1>
                    <group>
                        <group>
                            <field name="description" />
                        </group>
                        <group>
                        </group>
                    </group>
                    <field name="item_ids" no_create="1">
                        <kanban>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_card oe_kanban_global_click">
                                        <div class="o_kanban_image_full me-1">
                                            <img
                                                t-att-src="kanban_image('media.gallery.item', 'image_256', record.id.raw_value)"
                                                alt="Photo"
                                            />
                                        </div>
                                        <div class="oe_kanban_details">
                                            <div class="o_kanban_record_top mb-0">
                                                <div class="o_kanban_record_headings">
                                                    <strong
                                                        class="o_kanban_record_title"
                                                    >
                                                        <field name="name" />
                                                    </strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_media_gallery" model="ir.actions.act_window">
        <field name="name">Galleries</field>
        <field name="res_model">media.gallery</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
