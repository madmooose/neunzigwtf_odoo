<odoo>
    <record id="group_media_gallery_manager" model="res.groups">
        <field name="name">Media Gallery Manager</field>
        <field name="category_id" ref="base.module_category_website" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>
    <record id="media_gallery_item_rule_manager" model="ir.rule">
        <field name="name">Manager: full access</field>
        <field name="model_id" ref="model_media_gallery_item" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field
            name="groups"
            eval="[(4, ref('media_gallery.group_media_gallery_manager'))]"
        />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="media_gallery_item_subject_rule_manager" model="ir.rule">
        <field name="name">Manager: full access</field>
        <field name="model_id" ref="model_media_gallery_item_subject" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field
            name="groups"
            eval="[(4, ref('media_gallery.group_media_gallery_manager'))]"
        />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="media_gallery_item_rule_portal" model="ir.rule">
        <field name="name">Portal: Sichtbare Medien</field>
        <field name="model_id" ref="media_gallery.model_media_gallery_item" />
        <field name="domain_force">
            [('state', '=', 'approved'),
             '|',
                ('visibility', 'in', ['public', 'users']),
                '&amp;',
                    ('visibility', '=', 'own'),
                    ('subject_ids.user_id', '=', user.id)
            ]
        </field>
        <field
            name="groups"
            eval="[(4, ref('base.group_portal')), (4, ref('base.group_user'))]"
        />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
</odoo>
