<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_media_gallery_batch_upload_wizard_form" model="ir.ui.view">
        <field name="name">media.gallery.batch.upload.wizard.form</field>
        <field name="model">media.gallery.batch.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Upload Media Items">
                <group>
                    <field name="gallery_id" />
                    <field name="zip_file" filename="zip_filename" />
                </group>
                <footer>
                    <button
                        name="action_upload"
                        type="object"
                        string="Upload"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_media_gallery_batch_upload_wizard" model="ir.actions.act_window">
        <field name="name">Batch Upload</field>
        <field name="res_model">media.gallery.batch.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
