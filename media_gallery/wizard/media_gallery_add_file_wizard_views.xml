<odoo>
    <record id="view_media_gallery_add_file_wizard_form" model="ir.ui.view">
        <field name="name">media.gallery.add.file.wizard.form</field>
        <field name="model">media.gallery.add.file.wizard</field>
        <field name="arch" type="xml">
            <form string="Add File to Gallery">
                <group>
                    <field name="gallery_id" />
                    <field name="name" />
                    <field name="attachment" filename="filename" />
                    <field name="description" />
                </group>
                <footer>
                    <button
                        name="action_add_file"
                        type="object"
                        string="Upload"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_media_gallery_add_file_wizard" model="ir.actions.act_window">
        <field name="name">Add File to Gallery</field>
        <field name="res_model">media.gallery.add.file.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_media_gallery_add_file_wizard_form" />
    </record>
</odoo>
