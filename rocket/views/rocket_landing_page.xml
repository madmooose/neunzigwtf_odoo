<odoo>
    <template id="rocket_landing_template" name="Rocket Landing Page">
        <t t-set="no_header" t-value="True" />
        <t t-set="no_footer" t-value="True" />
        <t t-call="web.frontend_layout">
            <div class="rocket-container o_fullscreen">
                <canvas
                    id="bubble-canvas"
                    class="position-absolute w-100 h-100 z-n1 pe-none"
                />
                <div
                    class="position-absolute top-50 start-50 translate-middle text-center"
                >
                    <h1
                        class="text-4xl md:text-6xl lg:text-8xl xl:text-9xl font-bold neunzigwtf"
                    >neunzig.wtf</h1>
                </div>
                <div class="rocket">
                    <a href="/home" alt="Going Home">
                        <img
                            src="/rocket/static/src/img/my_rocket.svg"
                            alt="Flying Rocket"
                        />
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
